# 佛說 — 環境變量配置
# 複製此文件為 .env.local 並填入真實值

# ── MiniMax API（AI 問佛 + TTS 降級）────────────────────────────
# 申請地址：https://platform.minimax.io
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare R2（音頻預生成存儲）───────────────────────────────
# 申請步驟：
#   1. Cloudflare 控制台 → R2 → 建立 Bucket（如 foshuo-audio）
#   2. R2 → 管理 API 令牌 → 建立具有讀寫權限的 Token
#   3. Bucket → 設定 → 公開存取 → 啟用（取得公開域名）
#
# 免費額度：10GB 存儲 + 100萬次讀取/月（完全夠用）
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=foshuo-audio
R2_PUBLIC_URL=https://your-bucket.your-subdomain.r2.dev

# ── Vercel Cron 安全密鑰（防止外部隨意觸發）─────────────────────
# 隨機生成一個字符串即可，如：openssl rand -hex 32
CRON_SECRET=your-random-secret-string
